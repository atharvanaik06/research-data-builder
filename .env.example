RESEARCH_DATA_ENVIRONMENT=development
RESEARCH_DATA_LOG_LEVEL=INFO
RESEARCH_DATA_DATABASE_URL=postgresql+psycopg://research_data:research_data@localhost:5432/research_data
# Add a real key only to your local .env file. Never commit provider credentials.
RESEARCH_DATA_FRED_API_KEY=
RESEARCH_DATA_PROVIDER_HTTP_TIMEOUT_SECONDS=15
RESEARCH_DATA_PROVIDER_HTTP_MAX_ATTEMPTS=3
RESEARCH_DATA_PROVIDER_CACHE_TTL_HOURS=24
RESEARCH_DATA_ARTIFACT_ROOT=artifacts
RESEARCH_DATA_ARTIFACT_STORAGE_BACKEND=local
# Hosted deployments can use an S3-compatible service. Leave these blank for local storage.
RESEARCH_DATA_ARTIFACT_S3_BUCKET=
RESEARCH_DATA_ARTIFACT_S3_ENDPOINT_URL=
RESEARCH_DATA_ARTIFACT_S3_REGION=auto
RESEARCH_DATA_ARTIFACT_S3_ACCESS_KEY_ID=
RESEARCH_DATA_ARTIFACT_S3_SECRET_ACCESS_KEY=
RESEARCH_DATA_ARTIFACT_MAX_BUNDLE_BYTES=26214400
RESEARCH_DATA_ARTIFACT_MAX_DOWNLOAD_BYTES=26214400
RESEARCH_DATA_SESSION_COOKIE_NAME=research_data_session
RESEARCH_DATA_SESSION_TTL_HOURS=168
RESEARCH_DATA_WORKER_POLL_SECONDS=1
RESEARCH_DATA_WORKER_LEASE_SECONDS=60
RESEARCH_DATA_EMBEDDED_WORKER_ENABLED=false
RESEARCH_DATA_MAX_OUTSTANDING_BUILDS_PER_USER=5
RESEARCH_DATA_MAX_RECIPE_BYTES=65536

